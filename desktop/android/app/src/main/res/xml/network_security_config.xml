<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext is denied by default, so the paired gateway is reached over https
     (the Cloudflare tunnel is the shipped path). Plain http is permitted only to
     the local dev hosts: 10.0.2.2 is the emulator's route to the PC, and
     127.0.0.1 / localhost are the loopback. To reach a gateway directly over the
     LAN by http instead of the tunnel, add that PC's LAN IP here. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false"/>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
