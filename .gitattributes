# Canonical bytes. Hashes in this repository are computed over the bytes Git
# stores (the blob), and a checkout must write those same bytes on every
# platform. Git for Windows defaults to core.autocrlf=true, which rewrote every
# LF file to CRLF on checkout, so a stranger on Windows who ran sha256sum on a
# preregistered file got a false DRIFT (the Shapley placebo prereg pins
# harness/shapley_far.py and scripts/shapley_placebo_run.py by their LF bytes).
# text=auto eol=lf writes LF text files as LF whatever core.autocrlf says; Git
# does not touch files committed with CRLF; the rules below still override it
# per path. docs/CANONICAL-BYTES.md records the choice for each artifact class.
* text=auto eol=lf

# Shell scripts must stay LF: git autocrlf was rewriting them to CRLF on checkout,
# which makes WSL bash die with `syntax error near unexpected token $'{\r''`.
*.sh text eol=lf

# Windows scripts stay CRLF.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Receipt hashes cover captured bytes, so Git must not normalize the streams.
artifacts/closeout/**/stdout.txt -text -diff
artifacts/closeout/**/stderr.txt -text -diff

# Domain-pack oracle bindings hash their fixture bytes (source_sha256), so Git
# must not normalize them. Without this, a Windows checkout (core.autocrlf=true)
# rewrites the fixtures to CRLF and the hash check fails.
packs/**/fixtures/** -text -diff

# The monitor admission gate pins its set and spec by SHA-256 over these bytes.
harness/monitor_gate/data/** -text -diff

# Cross-harness oracles hash fixture bytes into every receipt as input_sha256s,
# so a CRLF checkout would record a different hash than an LF one for the same
# fixture. Same reason as the packs rule above.
benchmarks/fixtures/** -text -diff

# The task set and the adapter contracts are hashed into every manifest as
# task_set_sha256 and adapter_sha256. Same reason as the fixture rule above:
# a CRLF checkout would record a different hash for identical content.
benchmarks/*.json -text -diff

# The model-boundary-receipt golden fixture is a cross-language seal pin: its
# canonical-bytes and reseal tests hash the fixture bytes, so Git must not
# normalize the stream (same reason as packs/**/fixtures/** above).
tests/fixtures/model-receipt-golden.json -text -diff

# The monitor-outcome sidecar records the sha256 of the log it read, and the
# demo prints it. generate.py writes LF, so pin the checkout to LF and the
# recorded hash is the same whoever cloned the repository.
tests/fixtures/monitor_outcome/** text eol=lf

# Generated artwork. render_repo_art.py writes LF on every platform, so pin the
# checkout to LF as well and each file's size and hash stay the same whoever
# cloned the repository.
docs/art/*.svg text eol=lf
docs/art/*.json text eol=lf

# Desktop font notices are exact installer payload inputs; pin them so the
# validator sees the same bytes on Windows, Linux, and macOS checkouts.
desktop/release/FONT-PROVENANCE.json text eol=lf
desktop/release/THIRD-PARTY-NOTICES.txt text eol=lf
desktop/release/payload-policy.json text eol=lf

# Shader capture receipts bind source bytes across host platforms.
desktop/shaders/*.frag text eol=lf

# Flutter rewrites generated plugin registrants with LF on every platform, so
# pin their checkout bytes to the canonical Git bytes as well.
desktop/linux/flutter/generated_plugin_registrant.* text eol=lf
desktop/linux/flutter/generated_plugins.cmake text eol=lf
desktop/macos/Flutter/GeneratedPluginRegistrant.swift text eol=lf
desktop/windows/flutter/generated_plugin_registrant.* text eol=lf
desktop/windows/flutter/generated_plugins.cmake text eol=lf

# Vendored helpers are hash-pinned (VENDORED.sha256); keep their bytes exactly as copied.
**/_vendor/safe_spawn.py -text
# superstack.py v0.2.0 is pinned the same way (VENDORING.md in the superstack repo):
# a CRLF checkout would change its hash. The vectors it is tested against are hashed
# by their own MANIFEST.json, so they stay byte-exact too.
**/_vendor/superstack.py -text
tests/fixtures/superstack/** -text -diff
# raw-native renders: certificate.json records the SHA-256 of every file beside it.
tests/fixtures/raw_native/** -text -diff

# 1.3.0 evidence records: PREREG.sha256 covers these bytes, so Git must not
# normalize them.
project-docs/records/1.3.0/** -text -diff

# A pre-registration is checked by hash, so its checkout bytes must match the committed bytes.
project-docs/records/search-effort-gate/PREREG.md text eol=lf

# The Shapley placebo item set and run record are hashed into the preregistration
# and the run's witness entries, so Git must not normalize their bytes.
project-docs/records/2026-10-04-shapley-placebo/*.json -text -diff

# The PySyft result-receipt fixture is a real run's bundle. The receipt binds
# PySyft's hash over the job folder's raw bytes, so Git must not normalize them.
tests/fixtures/pysyft_receipt/** -text -diff

# The site-designer handoff is sealed by handoff/site-designer/MANIFEST.sha256, which
# records the SHA-256 of each file's exact bytes. A CRLF checkout changes every
# digest and puts a carriage return on every path in the manifest, so the check
# fails on files nobody edited. Same reason as the fixture rules above.
handoff/site-designer/** -text
# The Inspect contract fixtures are hashed into tests/fixtures/inspect/v1/manifest.json
# as fixture_sha256 and bytes_sha256, so their bytes must survive checkout unchanged.
tests/fixtures/inspect/v1/** -text
