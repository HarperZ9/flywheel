          "value": "flywheel-writing-workspace-mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "license": "FSL-1.1-MIT",
      "consoleScripts": [
        "flywheel-writing-lint-mcp",
        "flywheel-writing-workspace-mcp"
      ]
    }
  }
}
