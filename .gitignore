# --- secrets / env (NEVER commit) ---
.env
.env.*
*.key
*.pem
*.token
CLAUDE.local.md

# --- python ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- PyInstaller build artifacts (the release exe lives in artifacts/exe/) ---
build/
dist/
*.egg-info/
.venv/
venv/

# --- ephemeral harness output (regenerated by tests / runs) ---
envelopes-turn-*/
.warden-safe-cache/
*.safe

# --- proprietary corpus source identifiers ---
# INVARIANT: only aggregate stats leave the repo; the per-file source manifest
# enumerates real C:\dev source paths and must stay proprietary.
dataset/manifest.jsonl

# --- large run assets: these live on E:\local-model-run, never in the repo ---
*.safetensors
*.gguf
*.bin
*.pt
*.pth
checkpoints/
/models/
data/packed/

# --- os / editor noise ---
.DS_Store
Thumbs.db
*.swp
.m7-run/
artifacts/exe/
.pyinstaller/
*.spec
# the checked-in packaging spec is the exception (negation must follow *.spec)
!packaging/*.spec

# --- benchmark/screen scratch (never commit) ---
.screen-run/

# --- machine-local run root (keeps absolute paths out of shipped source) ---
# One line naming this machine's training/run root (e.g. E:/local-model-run).
# Read by harness/run_paths.py; never shipped, so the source stays path-clean.
.flywheel-run-root

# The committed template must survive the .env.* rule above (global standard)
!.env.example

# internal register: never ships from this public repo
project-docs/private/

# private denylist for the public-instruction gate (never ships)
scripts/.private-denylist.txt

# direnv environment files (can hold exported secrets)
.envrc
.envrc.local

# process-scratch dir (currently ignored only by a machine-local global rule)
.superpowers/

# isolated implementation worktrees
.worktrees/

# The walker's stderr, kept so a silent startup death is visible. Tracebacks
# carry absolute local paths, so this stays local and never becomes evidence.
artifacts/pool/walker-stderr.log

# Task 0 keeps two public-safe fixtures; later bootstrap diagnostics stay local.
artifacts/closeout/FW-2026-08-02-CLOSEOUT/task-0-bootstrap/*
!artifacts/closeout/FW-2026-08-02-CLOSEOUT/task-0-bootstrap/passing-fixture/
!artifacts/closeout/FW-2026-08-02-CLOSEOUT/task-0-bootstrap/passing-fixture/**
!artifacts/closeout/FW-2026-08-02-CLOSEOUT/task-0-bootstrap/failing-fixture/
!artifacts/closeout/FW-2026-08-02-CLOSEOUT/task-0-bootstrap/failing-fixture/**

# Task 1 raw evidence includes reproducible build trees and temporary virtual
# environments. A compact reviewed subset ships in the sibling `-reviewed`
# directory.
artifacts/closeout/FW-2026-08-02-CLOSEOUT/task-1-proof-surface/
artifacts/closeout/FW-2026-08-02-CLOSEOUT/task-1-proof-surface-final-head/

