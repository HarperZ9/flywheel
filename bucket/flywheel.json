{
    "version": "1.9.0",
    "description": "Run any model, keep a receipt you can recheck offline.",
    "homepage": "https://github.com/HarperZ9/flywheel",
    "license": "FSL-1.1-MIT",
    "depends": "python",
    "url": "https://files.pythonhosted.org/packages/py3/f/flywheel-verify/flywheel_verify-1.9.0-py3-none-any.whl",
    "hash": "6514e581ce1e684ce157cd50c59e8c48543fa32a9a070bdf27226da8237d39d5",
    "installer": {
        "script": [
            "$py = \"$(appdir 'python' $global)\\current\\python.exe\"",
            "if (!(Test-Path $py)) { $py = (Get-Command python -ErrorAction Stop).Source }",
            "& $py -m venv \"$dir\\venv\"",
            "if ($LASTEXITCODE -ne 0) { throw \"python -m venv failed with exit code $LASTEXITCODE\" }",
            "& \"$dir\\venv\\Scripts\\python.exe\" -m pip install --quiet --disable-pip-version-check --no-index --no-deps \"$dir\\$fname\"",
            "if ($LASTEXITCODE -ne 0) { throw \"pip install of $fname failed with exit code $LASTEXITCODE\" }"
        ]
    },
    "bin": [
        [
            "venv\\Scripts\\flywheel.exe",
            "flywheel"
        ]
    ],
    "notes": [
        "flywheel runs in its own environment under $dir\\venv.",
        "Next: flywheel doctor, then flywheel code in a project folder."
    ],
    "checkver": {
        "url": "https://pypi.org/pypi/flywheel-verify/json",
        "jsonpath": "$.info.version"
    },
    "autoupdate": {
        "url": "https://files.pythonhosted.org/packages/py3/f/flywheel-verify/flywheel_verify-$version-py3-none-any.whl",
        "hash": {
            "url": "https://pypi.org/pypi/flywheel-verify/$version/json",
            "jsonpath": "$.urls[?(@.packagetype == 'bdist_wheel')].digests.sha256"
        }
    }
}
